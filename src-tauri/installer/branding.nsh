!ifndef SPANDA_INSTALLER_BRANDING
!define SPANDA_INSTALLER_BRANDING

; Appearance only: Tauri continues to own installation, upgrades and uninstall.
SetFont "Segoe UI" 9
!define MUI_BGCOLOR "F7F8FA"
!define MUI_TEXTCOLOR "151820"
!define MUI_HEADERIMAGE_RIGHT
!define MUI_HEADERIMAGE_BITMAP_STRETCH FitControl
!define MUI_HEADERIMAGE_UNBITMAP_STRETCH FitControl
!define MUI_WELCOMEFINISHPAGE_BITMAP_STRETCH FitControl
!define MUI_WELCOMEPAGE_TITLE "Welcome to Spanda"
!define MUI_WELCOMEPAGE_TEXT "Where Sound Takes Shape.$\r$\n$\r$\nSpanda transforms your Windows system audio into immersive, real-time visuals. Derived from Sanskrit, Spanda, pronounced $\"spun-duh$\", means vibration or pulsation, capturing the very essence of sound.$\r$\n$\r$\nExplore a range of audio-reactive scenes and experience music in a whole new way.$\r$\n$\r$\nClick Next to continue with the installation."
!define MUI_FINISHPAGE_TITLE "Spanda is ready"
!define MUI_FINISHPAGE_TEXT "Your installation is complete.$\r$\n$\r$\nOpen Spanda, play some audio, and press Start to bring it to life."
!define MUI_FINISHPAGE_RUN_TEXT "Launch Spanda"

!endif
